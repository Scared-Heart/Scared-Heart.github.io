---
import Base from '../../layouts/Base.astro';
import TaxonomyIndex from '../../components/TaxonomyIndex.astro';
import { getPosts, groups } from '../../lib/posts';
const categories = groups(await getPosts(), 'categories');
---

<Base title="文章分类"
  ><header class="page-heading">
    <p class="eyebrow">EXPLORE BY TOPIC</p><h1>从兴趣出发</h1><p>
      安全事件、技术探索，还有日常闲话。挑一个感兴趣的话题。
    </p>
  </header><div class="page-content">
    <TaxonomyIndex groups={categories} kind="categories" /><p class="taxonomy-more">
      <a class="text-link" href="/tags/">也可以按标签查找 →</a>
    </p>
  </div></Base
>
<style>
  .taxonomy-more {
    margin-top: 28px;
  }
</style>
