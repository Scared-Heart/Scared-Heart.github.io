---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
---

<Base title="关于"
  ><header class="page-heading">
    <h1>关于</h1>
  </header><div class="page-content about-layout">
    <div class="about-copy">
      <p>我是 Breeze。这个博客始于 2019 年，记录技术和日常。</p>
      <p><a href="/archives/">全部文章（{posts.length}）</a></p><div class="about-links">
        <a class="text-link" href="https://github.com/Scared-Heart"
          ><Icon name="github" size={18} /> GitHub ↗</a
        ><a class="text-link" href="/rss.xml"><Icon name="rss" size={18} /> 订阅 RSS</a>
      </div>
    </div><figure>
      <img
        src="/img/banner-preview.webp"
        alt="橙色天空下独自行走的身影"
        width="340"
        height="320"
      /><figcaption>apple pie · 始于 2019</figcaption>
    </figure>
  </div></Base
>
<style>
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 70px;
  }
  .about-copy {
    max-width: 650px;
    font-size: 16px;
    line-height: 2;
  }
  .about-copy > p:first-child {
    margin-top: 0;
  }
  .about-copy a:not(.text-link) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  figure {
    margin: 0;
  }
  figure img {
    object-fit: cover;
    width: 100%;
    height: 310px;
    border-radius: 5px;
  }
  figcaption {
    font-size: 11px;
    color: var(--muted);
    margin-top: 9px;
  }
  .about-links {
    display: flex;
    gap: 30px;
    margin-top: 30px;
  }
  @media (max-width: 750px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .about-layout figure {
      display: none;
    }
    .about-copy {
      font-size: 15px;
    }
  }
</style>
