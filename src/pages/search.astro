---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="搜索文章" noindex>
  <header class="page-heading">
    <p class="eyebrow">FIND SOMETHING</p><h1>寻找一条记录</h1><p>
      搜索标题、标签和正文，找到你感兴趣的内容。
    </p>
  </header>
  <div class="page-content search-page">
    <form class="search-form" role="search">
      <label class="sr-only" for="search-input">搜索文章</label><Icon
        name="search"
        size={22}
      /><input
        id="search-input"
        name="q"
        type="search"
        placeholder="试试 fnOS、树莓派、证书…"
        autocomplete="off"
        maxlength="200"
      /><button type="submit">搜索</button>
    </form><p id="search-status" role="status" aria-live="polite">输入关键词，开始查找。</p><div
      id="search-results"
      class="search-results"
    >
    </div><noscript
      ><p>
        搜索需要 JavaScript。你也可以<a class="text-link" href="/archives/">查看全部文章 →</a>
      </p></noscript
    >
  </div>
  <script>
    import { searchPosts } from '../lib/search.mjs';
    type SearchPost = {
      title: string;
      url: string;
      description: string;
      date: string;
      categories: string[];
      tags: string[];
      body: string;
    };
    const form = document.querySelector<HTMLFormElement>('.search-form')!;
    const input = document.querySelector<HTMLInputElement>('#search-input')!;
    const status = document.querySelector<HTMLElement>('#search-status')!;
    const results = document.querySelector<HTMLElement>('#search-results')!;
    let index: SearchPost[] | undefined;
    let pending: Promise<SearchPost[]> | undefined;
    let revision = 0;
    async function run() {
      const current = ++revision;
      const query = input.value.trim();
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
      results.replaceChildren();
      if (!query) {
        status.textContent = '输入关键词，开始查找。';
        return;
      }
      status.textContent = '正在查找…';
      try {
        if (!index) {
          pending ??= fetch('/search-index.json').then((response) => {
            if (!response.ok) throw new Error('Search index unavailable');
            return response.json();
          });
          index = await pending;
        }
        if (current !== revision) return;
        const matches: SearchPost[] = searchPosts(index, query);
        status.textContent = matches.length
          ? `找到 ${matches.length} 篇相关记录`
          : '没有找到相关记录，试试更短的关键词。';
        for (const post of matches) {
          const card = document.createElement('article');
          const meta = document.createElement('p');
          meta.className = 'search-result-meta';
          meta.textContent = `${post.date} · ${post.categories.join(' / ') || '技术笔记'}`;
          const heading = document.createElement('h2');
          const link = document.createElement('a');
          link.href = post.url;
          link.textContent = post.title;
          heading.append(link);
          const description = document.createElement('p');
          description.textContent = post.description;
          card.append(meta, heading, description);
          results.append(card);
        }
      } catch {
        pending = undefined;
        if (current === revision)
          status.textContent = '搜索暂时无法加载，请点击“搜索”重试，或从归档中查找。';
      }
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void run();
    });
    let timer: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(run, 160);
    });
    input.value = new URLSearchParams(window.location.search).get('q')?.slice(0, 200) || '';
    if (input.value) void run();
  </script>
</Base>
<style>
  .search-page {
    max-width: 820px;
    min-height: 55vh;
  }
  .search-form {
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 8px;
    padding: 12px 15px;
  }
  .search-form:focus-within {
    border-color: var(--accent);
  }
  .search-form > svg {
    color: var(--muted);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: none;
    color: var(--ink);
    font-size: 16px;
    padding: 8px 0;
  }
  input:focus-visible {
    outline: none;
  }
  button {
    background: var(--ink);
    color: var(--bg);
    border: 0;
    border-radius: 5px;
    padding: 8px 18px;
    font-size: 13px;
  }
  #search-status {
    font-size: 12px;
    color: var(--muted);
    margin: 20px 0;
  }
  .search-results :global(article) {
    border-top: 1px solid var(--line);
    padding: 22px 0;
  }
  .search-results :global(h2) {
    font-size: 19px;
    line-height: 1.65;
    margin: 10px 0;
    color: var(--ink);
  }
  .search-results :global(h2 a:hover) {
    color: var(--accent);
  }
  .search-results :global(p) {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.9;
  }
  .search-results :global(.search-result-meta) {
    font: 11px var(--mono);
    margin: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  @media (max-width: 600px) {
    .search-form {
      gap: 10px;
      padding: 9px 12px;
    }
    input {
      font-size: 14px;
    }
    button {
      padding: 8px 13px;
    }
  }
</style>
