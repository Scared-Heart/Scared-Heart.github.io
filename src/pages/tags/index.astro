---
import Base from '../../layouts/Base.astro';
import TaxonomyIndex from '../../components/TaxonomyIndex.astro';
import { getPosts, groups } from '../../lib/posts';
const tags = groups(await getPosts(), 'tags');
---

<Base title="文章标签"
  ><header class="page-heading">
    <h1>标签</h1>
  </header><div class="page-content"><TaxonomyIndex groups={tags} kind="tags" /></div></Base
>
