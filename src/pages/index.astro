---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, postUrl } from '../lib/posts';
const posts = await getPosts();
---

<Base>
  <header class="original-cover">
    <img
      src="/img/banner-poster.webp"
      alt="橙色荒野中独自行走的身影"
      width="2400"
      height="1000"
      fetchpriority="high"
    />
    <div class="cover-title"><h1>apple pie</h1><hr /></div>
  </header>
  <section id="latest" class="original-list" aria-label="文章">
    {
      posts.map((post) => (
        <article>
          <h2>
            <a href={postUrl(post.id)}>{post.data.title}</a>
          </h2>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .original-cover {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 430px;
    display: grid;
    place-items: center;
    isolation: isolate;
    color: white;
    background: #a56518;
  }
  .original-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
  }
  .original-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(33, 33, 33, 0.15);
    z-index: -1;
  }
  .cover-title {
    text-align: center;
    transform: translateY(-5px);
  }
  .cover-title h1 {
    margin: 0;
    font: 800 80px/1.2 var(--heading);
    letter-spacing: normal;
  }
  .cover-title hr {
    width: 100px;
    margin: 15px auto 0;
    border: 0;
    border-top: 4px solid white;
  }
  .original-list {
    max-width: 730px;
    margin: 50px auto 70px;
  }
  .original-list article {
    padding: 26px 0 30px;
    border-bottom: 1px solid var(--line);
  }
  .original-list article:last-child {
    border-bottom: 0;
  }
  .original-list h2 {
    font: 800 36px/1.25 var(--heading);
    margin: 0 0 12px;
    color: var(--ink);
  }
  .original-list a:hover {
    color: var(--accent);
  }
  .original-list time {
    color: var(--muted);
    font:
      18px/1.5 Georgia,
      serif;
  }
  @media (max-width: 768px) {
    .original-cover {
      height: 270px;
    }
    .cover-title {
      padding-top: 35px;
    }
    .cover-title h1 {
      font-size: 50px;
    }
    .original-list {
      margin-top: 25px;
    }
    .original-list h2 {
      font-size: 28px;
    }
  }
</style>
