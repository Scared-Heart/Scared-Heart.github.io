{
  "name": "apple-pie-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "server": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "new": "node scripts/new-post.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "predev": "node scripts/prepare-images.mjs",
    "preserver": "node scripts/prepare-images.mjs",
    "prebuild": "node scripts/prepare-images.mjs",
    "format": "prettier --write src scripts tests astro.config.mjs package.json tsconfig.json .github/workflows/deploy.yml README.md"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "cheerio": "^1.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0"
  }
}
